{
  "name": "benura",
  "version": "2.0.0",
  "description": "Automações da discadora Argus: roteador de vendas (Carrossel → URA), rodízio Ativo ↔ URA com controle de robôs e cadastro de operadores",
  "private": true,
  "main": "roteador-vendas.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node roteador-vendas.js",
    "start:argus": "node argus-automacao.js",
    "cadastro": "node cadastrar-operador.js",
    "dev": "node scripts/dev.js",
    "mock": "node test/mock-vendas.js",
    "test": "node --test test/unit/*.test.js",
    "sim:iniciar": "node scripts/simulacao.js limpar && pm2 start ecosystem.simulacao.config.js",
    "sim:logs": "pm2 logs /benura-/ --lines 40",
    "sim:status": "node scripts/simulacao.js status",
    "sim:venda": "node scripts/simulacao.js venda",
    "sim:parar": "pm2 delete ecosystem.simulacao.config.js",
    "pm2:iniciar": "pm2 start ecosystem.config.js",
    "pm2:parar": "pm2 delete ecosystem.config.js",
    "test:cenarios": "node test/rodizio/cenarios.js",
    "atualizador:iniciar": "pm2 start ecosystem.atualizador.config.js",
    "atualizador:parar": "pm2 delete ecosystem.atualizador.config.js",
    "atualizador:agora": "node atualizador.js --uma-vez",
    "rotinas:agora": "node rotinas.js --agora",
    "bases:agora": "node rotinas.js --base",
    "aviso:teste": "node scripts/testar-aviso.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "jszip": "^3.10.1",
    "playwright-core": "^1.64.0"
  },
  "devDependencies": {
    "pm2": "^7.0.4",
    "exceljs": "^4.4.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
