# ═══════════════════════════════════════════════════════════════════
#  ROTEADOR DE VENDAS — Variáveis de Ambiente
# ═══════════════════════════════════════════════════════════════════
# Copie este arquivo para .env e ajuste os valores.
# Para carregar automaticamente, instale dotenv:
#   npm install dotenv
# E adicione no topo do roteador-vendas.js:
#   require('dotenv').config();
# ═══════════════════════════════════════════════════════════════════

# --- Argus (Discadora) ---
ARGUS_TOKEN=seu-token-aqui
ARGUS_BASE=https://argus.app.br/apiargus/cmd
GRUPO_URA_ID=2
GRUPO_ATIVO_ID=1

# --- Site de Vendas (carrossel.benconsig.com) ---
SITE_VENDAS_URL=https://carrossel.benconsig.com/api
SITE_VENDAS_TOKEN=seu-token-do-site-aqui

# --- Regras de Negócio ---
META_DIARIA=50000
POLL_VENDAS_MS=60000
HORARIO_CARGA=08:00
HORARIO_FIM=18:00

# --- Operacional ---
PORT=3001
DEBUG=0
DRY_RUN=0
USAR_MOCK=0

# ═══════════════════════════════════════════════════════════════════
#  MODO DESENVOLVIMENTO (com mock server)
# ═══════════════════════════════════════════════════════════════════
# Para testar com o mock server, use estes valores:
#
# ARGUS_TOKEN=mock-token
# ARGUS_BASE=http://localhost:8081/apiargus/cmd
# SITE_VENDAS_URL=http://localhost:8081/api
# SITE_VENDAS_TOKEN=mock-token
# USAR_MOCK=0
# DRY_RUN=0
# DEBUG=1
