# ═══════════════════════════════════════════════════════════════════
#  ROTEADOR DE VENDAS — Variáveis de Ambiente
# ═══════════════════════════════════════════════════════════════════
# Copie para .env e ajuste. O arquivo é carregado automaticamente (dotenv).
# ═══════════════════════════════════════════════════════════════════

# --- API do Carrossel (repositório Carrosel-BenApi) ---
# Endereço do servidor do Carrossel (porta padrão dele: 4115), sem barra no final.
CARROSSEL_API_URL=http://servidor-do-carrossel:4115
# Rota consumida: GET {CARROSSEL_API_URL}{CARROSSEL_ROTA_RANKING}
CARROSSEL_ROTA_RANKING=/ranking/vendedores
# Campo da linha "GERAL" usado como total vendido:
#   vendaConcluida (padrão, mesmo critério da meta diária do Carrossel),
#   vendaGeral (concluída + pendente), Integrado, vendaPendente
CARROSSEL_METRICA=vendaConcluida
# A rota hoje é aberta. Preencha só se o Carrossel passar a exigir token.
CARROSSEL_API_TOKEN=
CARROSSEL_HEADER_AUTH=Authorization
CARROSSEL_ESQUEMA_AUTH=
CARROSSEL_TIMEOUT_MS=15000
CARROSSEL_TENTATIVAS=3

# --- Exceções (opcionais) ---
# O ramal de cada vendedor e o grupo de cada supervisor são descobertos
# automaticamente pelo /listarusuarios da Argus. Use estes arquivos só para
# corrigir casos que a descoberta não resolve. Edições valem sem reiniciar.
#   Nome no Carrossel diferente do nome na Argus:  vendedores-ramais.example.json
#   Supervisor cujo grupo não é identificado:       supervisores-grupos.example.json
VENDEDORES_RAMAIS_FILE=./vendedores-ramais.json
SUPERVISORES_GRUPOS_FILE=./supervisores-grupos.json

# --- Argus (Discadora) ---
ARGUS_TOKEN=seu-token-aqui
ARGUS_BASE=https://argus.app.br/apiargus/cmd
GRUPO_URA_ID=2
# Grupos do Ativo (um por supervisor: GABRIEL - COMERCIAL, MAYSA - COMERCIAL...),
# separados por vírgula. Mesma variável usada pelo argus-automacao.js.
GRUPOS_ATIVOS_IDS=1,3
ARGUS_TIMEOUT_MS=5000
ARGUS_TENTATIVAS=2
ARGUS_CACHE_GRUPOS_MS=15000
ARGUS_CACHE_DIRETORIO_MS=300000

# --- Rodízio Ativo ↔ URA + robôs (argus-automacao.js / benura-rodizio) ---
# Usa também ARGUS_TOKEN, ARGUS_BASE, GRUPO_URA_ID, GRUPOS_ATIVOS_IDS, WEBHOOK_TOKEN e DRY_RUN.
# Grupos dos robôs (operadores virtuais) da URA, separados por vírgula. Hoje: URA PORT 3.
# (GRUPO_ROBOS_URA_ID, com um grupo só, continua aceito.)
GRUPOS_ROBOS_URA_IDS=6
# panico (padrão): a supervisão liga os robôs pelo painel; o BenURA só os desliga quando a URA fica
# com 1 livre ou menos (interruptor na página /ura). automatico: o BenURA liga e desliga os robôs
# proporcionalmente aos livres (variáveis ROBOS_* abaixo).
ROBOS_MODO=panico
# [NOVO] O painel (aba URA e robôs) troca o modo na hora: automático, só pânico ou desligados.
# A escolha fica neste arquivo e vale até trocarem; ROBOS_MODO acima vira só o padrão inicial.
# ROBOS_MODO_FILE=./state-robos-modo.json
# Interruptor do pânico sem escolha gravada (true = ligado)
PANICO_PADRAO=true
# RODIZIO_PANICO_FILE=./state-panico.json
# Pânico com 1 livre comum: os robôs só param quando ele está a isso de sair por ociosidade
# (os em ligação terminam antes). Com 0 livre, desliga todos na hora.
PANICO_ANTES_DE_SAIR_MS=60000
# Pânico com 1 fixo livre: desliga a metade dos robôs ligados (poupa quem está em ligação; fica
# pelo menos 1) e de novo a cada N segundos. Livre há PANICO_FIXO_OCIOSO_MIN, os robôs seguem
# até ele atender (a URA está calma; aí sobra 0 livre e desligam todos). Com a URA em CALMA
# (status da URA no painel: automático pelo termômetro ou manual), também seguem.
PANICO_FIXO_REDUZIR_A_CADA_S=60
PANICO_FIXO_OCIOSO_MIN=3
# Status da URA escolhido no painel (manual) — as faixas do termômetro automático ficam em
# src/config/uraThresholds.js e os limites das pausas em src/config/pausas.js.
# RODIZIO_STATUS_URA_FILE=./state-status-ura.json
# Relatório do dia do painel (gravado para um reinício no mesmo dia continuar):
# RODIZIO_ESTATISTICAS_FILE=./state-estatisticas-dia.json
# Robôs ligados por humano LIVRE no RECEPTIVO - URA: 1 livre = 7, 2 livres = 14...
# Ninguém livre = todos desligados. Ajuste conforme a agressividade da URA no dia.
ROBOS_POR_LIVRE=7
# [Modo automático] O status da URA pesa nos robôs por livre (calma = mais, agressiva = menos):
# ROBOS_FATOR_CALMA=1.3
# ROBOS_FATOR_AGRESSIVA=0.7
# Teto de robôs ligados ao mesmo tempo (0 = todos os robôs dos grupos)
ROBOS_MAXIMO=0
# Com 1 livre só na URA, no máximo estes robôs (dois clientes juntos para um livre = callback). 0 = sem teto.
ROBOS_MAX_COM_1_LIVRE=6
# Ajuste dos robôs por livre: cada "abandonou/time-out na fila" (webhook tipo 5) baixa um degrau
# de robôs por livre, até o mínimo; sem callback por N min, sobe um de volta até ROBOS_POR_LIVRE.
ROBOS_AJUSTE_CALLBACK=1
ROBOS_POR_LIVRE_MINIMO=4
# URA passiva (livres parados, robôs no alvo, ninguém atendendo por N min): sobe ROBOS_AJUSTE_DEGRAU
# robôs por livre, até o máximo. O callback desce o mesmo degrau. Ajuste manual: página /ura.
ROBOS_POR_LIVRE_MAXIMO=15
ROBOS_PASSIVA_APOS_MIN=2
ROBOS_AJUSTE_DEGRAU=2
ROBOS_RECUPERAR_APOS_MIN=15
# ROBOS_AJUSTE_INTERVALO_S=60
# RODIZIO_AJUSTE_FILE=./state-ajuste-robos.json
# Vigia de callbacks: lê o relatório de ligações dos robôs a cada N s (só leitura) e grava o raio-x
# de cada callback em logs/AAAA-MM-DD/callbacks.txt; também desce o ajuste sem precisar do webhook.
# 0 = desligado. Com mais de uma campanha ativa, informe a dos robôs.
CALLBACKS_VERIFICAR_SEG=60
# CAMPANHA_ROBOS_ID=
# 1 = só sobe do Ativo para a URA quem o roteador pôs na URA hoje (meta de ontem, venda hoje ou fixo),
#     lido do STATE_FILE do roteador. Sem a lista do dia, só os fixos sobem (e o log avisa). 0 = todos sempre.
RODIZIO_SO_ELEGIVEIS=1
# Minutos ocioso (Livre) seguidos na URA antes de voltar ao Ativo (vale para todos; atender zera)
TEMPO_MIN=2
# [NOVO] Com a URA cheia ligada, o limite é este
# URA_CHEIA_TEMPO_MIN=2
# [NOVO] Prioridade por tempo de casa (ramal menor = mais antigo): sobe primeiro, sai por último e
# ganha este tanto a mais por posição antes de sair por ociosidade, até o máximo (0 = sem a escada)
# PRIORIDADE_RAMAL_PASSO_S=10
# PRIORIDADE_RAMAL_MAX_S=60
# A regra do ocioso vale sempre: o último livre sai no horário. Quando ele está a este tempo (ms)
# de sair, os robôs param de discar para os que estão em ligação terminarem antes (máx. metade do TEMPO_MIN).
PREPARAR_SAIDA_ULTIMO_LIVRE_MS=30000
# Quem acabou de passar a telefonia para a URA (troca de grupo ou relogin) só conta como livre
# para os robôs depois de CARENCIA_TROCA_GRUPO_MS; movido offline só volta depois de OFFLINE_VOLTA_APOS_MS.
CARENCIA_TROCA_GRUPO_MS=60000
OFFLINE_VOLTA_APOS_MS=60000
# Intervalo entre consultas à Argus (ms). 5 s evita liga-desliga de robôs a cada oscilação.
POLL_ATIVO_MS=5000
POLL_URA_MS=5000
# URA em alerta: com 1 a LIVRES_ALERTA livres, lê a URA a cada POLL_URA_ALERTA_MS
POLL_URA_ALERTA_MS=1000
LIVRES_ALERTA=2
REFRESH_GRUPOS_MS=30000
REATIVAR_ROBOS=true
# Espera para voltar a AUMENTAR robôs depois de reduzir (reduzir é imediato)
MIN_ROBOS_OFF_MS=15000
# Como na operação manual: com gente livre, só reduz se a queda de livres durar isso
# (ninguém livre continua desligando na hora); religa no máximo ROBOS_DEGRAU robôs
# a cada ROBOS_SUBIDA_INTERVALO_MS, para não discar todos juntos.
ROBOS_REDUZIR_APOS_MS=10000
ROBOS_DEGRAU=7
ROBOS_SUBIDA_INTERVALO_MS=10000
CONCORRENCIA=20
WEBHOOK_GRACE_MS=1500
STATUS_LIVRE=livre,disponivel
STATUS_ATENDIMENTO=atendimento,em atendimento,falando,conversa
# Desligado (robô desligado responde com status "Deslogado")
STATUS_OFFLINE=deslogado,offline,desconectado
# Porta e arquivos próprios (não colidem com PORT/STATE_FILE do roteador).
# Configure na Argus o webhook de atendimento para: http://SEU-SERVIDOR:3000/webhook?token=SEU_WEBHOOK_TOKEN
RODIZIO_PORT=3000
# RODIZIO_STATE_FILE=./state.json
# URA cheia (GET /ura): ligada pela supervisão, vale até desligar ou virar o dia
# RODIZIO_URA_CHEIA_FILE=./state-ura-cheia.json
# RODIZIO_LOCK_FILE=./argus.lock

# --- Retorno de quem desistiu da fila da URA (dentro do benura-rodizio) ---
# Configure na Argus o webhook "Encerramento de URA" (tipo 5) para a mesma URL do rodízio.
# Abandono / sem agente / time-out → lead na skill abaixo com origem RETORNO_URA;
# cliente atendido depois → o retorno pendente é removido. Respeita DRY_RUN.
RETORNO_FILA_ATIVO=false
# Hash da skill existente que recebe os retornos (veja /listarskills)
RETORNO_SKILL_HASH=
# O mesmo telefone gera um retorno só dentro desta janela
RETORNO_JANELA_HORAS=4
RETORNO_INCLUIR_FORA_HORARIO=true
# RETORNO_ORIGEM=RETORNO_URA
# RETORNO_STATE_FILE=./state-retorno-fila.json
# RETORNO_LOG_FILE=./logs/retorno-fila.jsonl
# URL de mailing da Argus; padrão: ARGUS_BASE sem o "/cmd"
# ARGUS_BASE_MAILING=https://argus.app.br/apiargus

# --- Rotinas diárias (rotinas.js / benura-rotinas) ---
# Fim de expediente: HORARIO_FIM + margem, confere quem continua logado.
#   relatar  = só avisa (padrão)
#   deslogar = também desconecta quem está fora de atendimento (em atendimento nunca)
FIM_EXPEDIENTE_ATIVO=true
FIM_EXPEDIENTE_ACAO=relatar
FIM_EXPEDIENTE_MARGEM_MIN=10
# Ramais de plantão que podem ficar logados, separados por vírgula
FIM_EXPEDIENTE_IGNORAR_RAMAIS=
# FIM_EXPEDIENTE_LOG_FILE=./logs/fim-expediente.jsonl
# ROTINAS_PORT=3003
# ROTINAS_INTERVALO_MS=60000

# --- Notificações ---
# log = log do processo + logs/notificacoes.jsonl
NOTIFICADOR=log
# NOTIFICACOES_FILE=./logs/notificacoes.jsonl

# --- Regras de Negócio ---
META_DIARIA=50000
# Operadores fixos: começam o dia na URA com ou sem venda (mesmo com o Carrossel fora do ar).
# Ramais ou nomes como na Argus, separados por vírgula. Ex.: OPERADORES_FIXOS_URA=1004,Maria Souza
OPERADORES_FIXOS_URA=
# Equipes fixas: toda a equipe destes supervisores (nomes como na Argus) é tratada como fixa.
# Ex.: EQUIPES_FIXAS_URA=ROBSON JUNIOR
EQUIPES_FIXAS_URA=
# Fora dos fixos mesmo estando numa equipe fixa (quem saiu e ainda aparece com o supervisor na Argus)
FORA_DOS_FIXOS_URA=
# true = fixos e equipes fixas ficam na URA de vez (sem a regra do ocioso); false = seguem o rodízio
FIXOS_PERMANENTES_URA=true
# 1 = não puxa vendedores que estejam em grupos fora de URA/Ativo
#     (ex.: movidos manualmente para treinamento/supervisão)
RESPEITAR_GRUPOS_EXTERNOS=1

# --- Agenda ---
POLL_VENDAS_MS=60000
HORARIO_CARGA=08:00
HORARIO_FIM=18:00
FUSO_HORARIO=America/Sao_Paulo

# --- Servidor HTTP ---
PORT=3001
# Protege POST /webhook/venda e POST /recarregar
# (header "Authorization: Bearer <token>" ou "X-Webhook-Token: <token>")
WEBHOOK_TOKEN=

# --- Painel da supervisão (painel.js / benura-painel) ---
# Uma página com os controles da URA, a esteira manual, a saúde dos serviços e o dia:
# http://localhost:3010 (na rede: http://<IP deste PC>:3010). Fala com os outros
# serviços levando o WEBHOOK_TOKEN; quem usa a página só precisa do e-mail e da senha.
# Cada pessoa tem o seu usuário (e-mail, senha e papel: Administrador, Supervisor ou
# Visualização). Crie o primeiro administrador neste PC:  npm run usuarios -- criar
# Os outros, pelo painel (Serviços → Usuários). Ficam em USUARIOS_FILE (não vai para o git).
# USUARIOS_FILE=./state-usuarios.json
# Acesso de emergência: só enquanto não houver nenhum usuário, a PAINEL_SENHA (8+
# caracteres) entra como administrador, para criar o primeiro pelo painel. Depois não vale.
PAINEL_SENHA=
# PAINEL_PORT=3010
# Horas até pedir a senha de novo
# PAINEL_SESSAO_HORAS=12
# Assinatura das sessões: gerada sozinha em painel-segredo.key (não vai para o git)
# PAINEL_SEGREDO_FILE=./painel-segredo.key
# Página no Cloudflare Pages (README: "Servidor + Cloudflare Pages"): o endereço dela e o
# segredo combinado com a Function do Pages (o mesmo valor vai nas variáveis do Pages).
# Gere o segredo com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Com o segredo definido, pelo túnel só entra a Function; no localhost e na rede, nada muda.
# PAINEL_ORIGENS_PERMITIDAS=https://benura.benconsig.com.br   (temporário: https://benura.pages.dev)
# PAINEL_PROXY_SEGREDO=

# --- [NOVO] Dois PCs: servidor e reserva (README: "Dois PCs") ---
# Só um age de verdade na Argus por vez: quem age segura a trava (Pages Function /trava, base D1).
# Sem TRAVA_URL, tudo como antes. Os dois PCs usam a mesma TRAVA_URL e o mesmo TRAVA_SEGREDO.
# TRAVA_URL=https://benura.benconsig.com.br/trava
# TRAVA_SEGREDO=
# Nome deste PC na tela e na trava (um diferente em cada PC)
# BENURA_NOME_PC=servidor
# O painel do outro PC, pela rede da empresa (copia os usuários e o estado do dia), e o
# segredo combinado entre os dois (o mesmo nos dois .env; 32+ caracteres)
# TRAVA_PARCEIRO_URL=http://192.168.0.21:3010
# TRAVA_SEGREDO_LOCAL=
# Se o /trava ficar atrás do Cloudflare Access: o service token
# TRAVA_ACCESS_CLIENT_ID=
# TRAVA_ACCESS_CLIENT_SECRET=
# Validade da trava, renovação e quanto a posse local vale para os serviços
# TRAVA_VALIDADE_MS=120000
# TRAVA_RENOVAR_MS=30000
# POSSE_MAX_MS=90000
# POSSE_FILE=./state-posse.json

# --- Botão "Desligar automação" do painel ---
# Desligada, roteador, rodízio e rotinas param e, se subirem de novo (PC reiniciado,
# pm2 start, atualizador), esperam sem mexer na Argus até alguém religar pelo painel.
# AUTOMACAO_FILE=./state-automacao.json
# Ao desligar: tempo para os robôs em ligação terminarem antes de derrubar os que sobrarem
# AUTOMACAO_ESPERA_ROBOS_MS=90000
# [NOVO] Agenda: o painel desliga a automação às AGENDA_DESLIGAR e religa às AGENDA_RELIGAR,
# de segunda a sexta (a noite e o fim de semana não entram no relatório do dia). Só religa
# o que ela mesma desligou. Vazio = sem agenda (ex.: no PC reserva).
# AGENDA_DESLIGAR=18:00
# AGENDA_RELIGAR=08:00
# Botão "Modo simulação" do painel (aba Serviços): ligado aqui, os serviços sobem em DRY_RUN
# mesmo com DRY_RUN=0. Com DRY_RUN=1 no .env, a simulação fica fixa (o botão não desliga).
# SIMULACAO_FILE=./state-simulacao.json
# "Alocar Todos no Ativo" (aba Receptivo): ninguém sobe para a URA até "Retomar rodízio da URA".
# O rodízio grava, o roteador lê; vale até retomarem (não vira com o dia).
# RETENCAO_ATIVO_FILE=./state-retencao-ativo.json
# Trava manual da aba Receptivo: quem a supervisão mexe à mão (Ativo ↔ URA) fica onde foi posto
# até "Liberar para o rodízio" ou virar o dia. O rodízio grava, o roteador lê.
# TRAVAS_MANUAIS_FILE=./state-travas-manuais.json

# --- Atualizador da produção (atualizador.js / benura-atualizador) ---
# Deploy automático: busca a main a cada minuto e, fora do expediente
# (HORARIO_CARGA–HORARIO_FIM em dias úteis; fim de semana livre), atualiza e
# recarrega os serviços — com volta automática se os testes ou o /health falharem.
# Desligado até você rodar: npm run atualizador:iniciar
# ATUALIZADOR_BRANCH=main
# ATUALIZADOR_INTERVALO_MS=60000
# ATUALIZADOR_APPS=benura-roteador,benura-rodizio,benura-rotinas,benura-painel
# ATUALIZADOR_HEALTH_URLS=http://localhost:3001/health,http://localhost:3000/health,http://localhost:3003/health
# ATUALIZADOR_HEALTH_TIMEOUT_MS=30000
# ATUALIZADOR_PORT=3002
# ATUALIZADOR_LOG_FILE=./logs/deploy.jsonl

# --- Perfis de clientes e cliente de risco em ligação (dentro do benura-rodizio) ---
# O telefone não é guardado: chave = HMAC com PERFIS_SEGREDO (vazio = arquivo perfis-segredo.key, criado sozinho).
PERFIS_ATIVO=1
# PERFIS_SEGREDO=
PERFIS_DIAS=30
# Cliente de risco: tantos callbacks OU atendeu o robô tantas vezes nos PERFIS_DIAS (0 = não usa o critério)
PERFIL_RISCO_CALLBACKS=1
PERFIL_RISCO_ATENDE=3
# A cada quantos segundos procura cliente de risco em ligação com um robô (0 = desligado)
PERFIS_VIGIA_SEG=10
# Padrão do interruptor "Desligar robôs com cliente de risco" (página /ura)
RISCO_DESLIGA_ROBOS=false
# PERFIS_FILE=./state-perfis-clientes.json
# PERFIS_HISTORICO_FILE=./state-perfis-historico.json
# RODIZIO_RISCO_FILE=./state-risco.json

# --- Logs em arquivos de texto: logs/AAAA-MM-DD/<serviço>.txt, avisos.txt e callbacks.txt ---
LOGS_ARQUIVOS=1
# LOGS_DIR=./logs
# Pastas de dias mais antigos que isso são apagadas (0 = guarda tudo)
LOGS_DIAS=30

# --- Operacional ---
DEBUG=0
DRY_RUN=0
USAR_MOCK=0
# Mover de grupo muda a lista na hora, mas a telefonia só troca quando a pessoa fica livre
# (com atraso da discadora). O BenURA só conta como livre na URA quem já está logado nela.
# Padrão (true): quem fica preso no grupo antigo por mais de ALINHAR_LOGIN_APOS_MS e está livre
# é logado de novo (logaroperador), e a telefonia vai para o grupo novo. Nunca desloga ninguém.
# false: o BenURA só move de grupo; quem continuar preso não recebe derivação nem conta como
# livre (e, livre além do tempo de ociosidade, volta ao Ativo). Respeita DRY_RUN.
ALINHAR_LOGIN_APOS_TRANSFERIR=true
# ALINHAR_LOGIN_APOS_MS=30000
# ALINHAR_LOGIN_ESPERA_MS=1500
# STATE_FILE=./state-vendas.json
# Esteira colada em http://localhost:PORT/manual quando o Carrossel cai
# ESTEIRA_MANUAL_FILE=./state-esteira-manual.json

# ═══════════════════════════════════════════════════════════════════
#  MODO DESENVOLVIMENTO
# ═══════════════════════════════════════════════════════════════════
# Sem rede nenhuma:            npm run dev   (USAR_MOCK=1: Carrossel e Argus simulados)
#
# Com o mock server HTTP (test/mock-vendas.js, porta 8081):
#   CARROSSEL_API_URL=http://localhost:8081
#   GRUPO_URA_ID=2
#   GRUPOS_ATIVOS_IDS=1,3
#   ARGUS_BASE=http://localhost:8081/apiargus/cmd
#   ARGUS_TOKEN=mock-token
#   DEBUG=1

# --- Pasta dos dados (estado, chaves e logs) ---
# Sem ela, tudo fica na pasta do projeto, como sempre. No Docker é /dados (o volume ./dados).
# DADOS_DIR=

# --- Túnel da Cloudflare no Docker (docker compose --profile tunel up -d) ---
# O token do túnel "benura" (Zero Trust → Networks → Tunnels → Install connector). É segredo:
# fica só no .env (que não vai para o git). No PM2 como serviço use npm run tunel:instalar.
# TUNNEL_TOKEN=
