# ═══════════════════════════════════════════════════════════════════
#  ROTEADOR DE VENDAS — Variáveis de Ambiente
# ═══════════════════════════════════════════════════════════════════
# Copie para .env e ajuste. O arquivo é carregado automaticamente (dotenv).
# ═══════════════════════════════════════════════════════════════════

# --- API do Carrossel (repositório Carrosel-BenApi) ---
# Endereço do servidor do Carrossel (porta padrão dele: 4115), sem barra no final.
CARROSSEL_API_URL=http://servidor-do-carrossel:4115
# Rota consumida: GET {CARROSSEL_API_URL}{CARROSSEL_ROTA_RANKING}
CARROSSEL_ROTA_RANKING=/ranking/vendedores
# Campo da linha "GERAL" usado como total vendido:
#   vendaConcluida (padrão, mesmo critério da meta diária do Carrossel),
#   vendaGeral (concluída + pendente), Integrado, vendaPendente
CARROSSEL_METRICA=vendaConcluida
# A rota hoje é aberta. Preencha só se o Carrossel passar a exigir token.
CARROSSEL_API_TOKEN=
CARROSSEL_HEADER_AUTH=Authorization
CARROSSEL_ESQUEMA_AUTH=
CARROSSEL_TIMEOUT_MS=15000
CARROSSEL_TENTATIVAS=3

# --- Exceções (opcionais) ---
# O ramal de cada vendedor e o grupo de cada supervisor são descobertos
# automaticamente pelo /listarusuarios da Argus. Use estes arquivos só para
# corrigir casos que a descoberta não resolve. Edições valem sem reiniciar.
#   Nome no Carrossel diferente do nome na Argus:  vendedores-ramais.example.json
#   Supervisor cujo grupo não é identificado:       supervisores-grupos.example.json
VENDEDORES_RAMAIS_FILE=./vendedores-ramais.json
SUPERVISORES_GRUPOS_FILE=./supervisores-grupos.json

# --- Argus (Discadora) ---
ARGUS_TOKEN=seu-token-aqui
ARGUS_BASE=https://argus.app.br/apiargus/cmd
GRUPO_URA_ID=2
# Grupos do Ativo (um por supervisor: GABRIEL - COMERCIAL, MAYSA - COMERCIAL...),
# separados por vírgula. Mesma variável usada pelo argus-automacao.js.
GRUPOS_ATIVOS_IDS=1,3
ARGUS_TIMEOUT_MS=5000
ARGUS_TENTATIVAS=2
ARGUS_CACHE_GRUPOS_MS=15000
ARGUS_CACHE_DIRETORIO_MS=300000

# --- Regras de Negócio ---
META_DIARIA=50000
# 1 = não puxa vendedores que estejam em grupos fora de URA/Ativo
#     (ex.: movidos manualmente para treinamento/supervisão)
RESPEITAR_GRUPOS_EXTERNOS=1

# --- Agenda ---
POLL_VENDAS_MS=60000
HORARIO_CARGA=08:00
HORARIO_FIM=18:00
FUSO_HORARIO=America/Sao_Paulo

# --- Servidor HTTP ---
PORT=3001
# Protege POST /webhook/venda e POST /recarregar
# (header "Authorization: Bearer <token>" ou "X-Webhook-Token: <token>")
WEBHOOK_TOKEN=

# --- Operacional ---
DEBUG=0
DRY_RUN=0
USAR_MOCK=0
# STATE_FILE=./state-vendas.json
# Trilha de auditoria do cadastro de operadores (JSON Lines)
# AUDITORIA_FILE=./auditoria-cadastro.jsonl

# ═══════════════════════════════════════════════════════════════════
#  MODO DESENVOLVIMENTO
# ═══════════════════════════════════════════════════════════════════
# Sem rede nenhuma:            npm run dev   (USAR_MOCK=1: Carrossel e Argus simulados)
#
# Com o mock server HTTP (test/mock-vendas.js, porta 8081):
#   CARROSSEL_API_URL=http://localhost:8081
#   GRUPO_URA_ID=2
#   GRUPOS_ATIVOS_IDS=1,3
#   ARGUS_BASE=http://localhost:8081/apiargus/cmd
#   ARGUS_TOKEN=mock-token
#   DEBUG=1
